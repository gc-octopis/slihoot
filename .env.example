PORT=3000
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=slihoot
DB_PASSWORD=slihoot
DB_NAME=slihoot
DB_AUTO_MIGRATE=true
# Leave REDIS_URL empty to disable Redis (the app falls back to MySQL only).
REDIS_URL=redis://127.0.0.1:6379
CLOUDFLARED_PATH=
# Production secrets (used by docker-compose / Caddy). Override before going live.
MYSQL_ROOT_PASSWORD=root
# DOMAIN: set to a real hostname for automatic HTTPS via Caddy; unset = HTTP on :80.
DOMAIN=

